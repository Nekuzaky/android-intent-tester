<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/builderScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="20dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/identity_title"
                android:textColor="@color/on_brand"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/identity_text"
                android:textColor="@color/on_brand"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_intent" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/actionInput"
                android:text="@string/field_action" />

            <AutoCompleteTextView
                android:id="@+id/actionInput"
                style="@style/FieldInput"
                android:completionThreshold="1"
                android:dropDownVerticalOffset="4dp"
                android:popupBackground="@color/surface_high"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/dataInput"
                android:text="@string/field_data" />

            <EditText
                android:id="@+id/dataInput"
                style="@style/FieldInput"
                android:inputType="textUri|textMultiLine" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/mimeInput"
                android:text="@string/field_mime" />

            <AutoCompleteTextView
                android:id="@+id/mimeInput"
                style="@style/FieldInput"
                android:completionThreshold="1"
                android:dropDownVerticalOffset="4dp"
                android:popupBackground="@color/surface_high"
                android:singleLine="true" />

            <Button
                android:id="@+id/categoriesToggle"
                style="@style/SecondaryButton"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/categoriesBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/categoriesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@+id/otherCategoriesInput"
                    android:text="@string/field_categories_other" />

                <EditText
                    android:id="@+id/otherCategoriesInput"
                    style="@style/FieldInput" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_target" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/packageInput"
                android:text="@string/field_package" />

            <EditText
                android:id="@+id/packageInput"
                style="@style/FieldInput"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/classInput"
                android:text="@string/field_class" />

            <EditText
                android:id="@+id/classInput"
                style="@style/FieldInput"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <Button
                android:id="@+id/flagsToggle"
                style="@style/SecondaryButton"
                android:layout_height="44dp"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/flagsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/BodyNote"
                    android:text="@string/flags_note" />

                <LinearLayout
                    android:id="@+id/flagsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_extras" />

            <LinearLayout
                android:id="@+id/extrasList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/addExtraButton"
                style="@style/SecondaryButton"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="@string/add_extra"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_send" />

            <Spinner
                android:id="@+id/modeSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:popupBackground="@color/surface_high"
                android:saveEnabled="false" />

            <CheckBox
                android:id="@+id/chooserCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:text="@string/use_chooser"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/warningsText"
                style="@style/BodyNote"
                android:textColor="@color/amber"
                android:visibility="gone" />

            <Button
                android:id="@+id/previewButton"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/preview_matches" />

            <Button
                android:id="@+id/sendButton"
                style="@style/PrimaryButton"
                android:layout_marginTop="8dp"
                android:filterTouchesWhenObscured="true"
                android:text="@string/send" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveFavouriteButton"
                    style="@style/RowButton"
                    android:layout_marginEnd="8dp"
                    android:text="@string/save_favourite" />

                <Button
                    android:id="@+id/clearFormButton"
                    style="@style/RowButton"
                    android:text="@string/clear_form" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_result" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/section_command" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_adb" />

            <TextView
                android:id="@+id/adbCommandText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_device" />

            <TextView
                android:id="@+id/deviceCommandText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/commandWarningsText"
                style="@style/BodyNote"
                android:textColor="@color/amber"
                android:visibility="gone" />

            <TextView
                style="@style/BodyNote"
                android:text="@string/command_note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copyAdbButton"
                    style="@style/RowButton"
                    android:layout_marginEnd="8dp"
                    android:text="@string/copy_adb" />

                <Button
                    android:id="@+id/copyDeviceButton"
                    style="@style/RowButton"
                    android:text="@string/copy_device" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
